  "license": "AGPL-3.0-only",
  "author": "Hussain Humaidan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussain-humaidan/Twin-Fabric.git"
  },
  "bugs": {
    "url": "https://github.com/hussain-humaidan/Twin-Fabric/issues"
  },
